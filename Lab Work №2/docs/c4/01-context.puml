@startuml 01-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title АрендаБот — диаграмма системного контекста (C4-L1)

Person(landlord, "Арендодатель", "SH-01. Владелец квартир или нежилых помещений: добавляет объекты, приглашает арендаторов, подтверждает чеки")
Person(tenant, "Арендатор", "SH-02 / SH-03. Физлицо или организация/ИП: получает напоминания, присылает чеки, показания, заявки на ремонт")
Person(admin, "Администратор сервиса", "SH-04. Следит за работой бота, блокирует нарушителей")

System(bot, "АрендаБот\n[System]", "Telegram-бот: напоминает об оплате и показаниях, принимает чеки и показания, считает суммы, ведёт задолженность")

System_Ext(tg, "Telegram Bot API", "SH-05. Платформа мессенджера: доставляет сообщения между пользователями и ботом")
System_Ext(ocr, "Сервис распознавания показаний (OCR/CV)", "SH-06. Распознаёт число на фото счётчика")
System_Ext(pay, "Платёжный провайдер", "SH-07. Принимает оплату подписки, формирует чек по 54-ФЗ")

Rel(landlord, bot, "Добавляет объекты, настраивает графики, подтверждает чеки, смотрит сводку", "через Telegram-клиент")
Rel(tenant, bot, "Присылает чеки, показания, заявки на ремонт; получает напоминания", "через Telegram-клиент")
Rel(admin, bot, "Блокирует пользователей, смотрит состояние рассылки", "через Telegram-клиент, админ-команды")

Rel(tg, bot, "Доставляет сообщения, нажатия кнопок и события оплаты", "HTTPS webhook, JSON")
Rel(bot, tg, "Отправляет ответы и напоминания, скачивает фото и PDF, выставляет счёт на подписку", "HTTPS/REST (Bot API)")
Rel(bot, ocr, "Отправляет фото счётчика, получает число и уверенность", "HTTPS/REST, JSON")
Rel(tg, pay, "Проводит оплату подписки арендодателя", "Telegram Payments")

Lay_R(landlord, tenant)
Lay_R(tenant, admin)

SHOW_LEGEND()
@enduml
